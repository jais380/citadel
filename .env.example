# ─────────────────────────────────────────────────────────────
# Citadel — local workstation settings
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# ── Orchestrator ─────────────────────────────────────────────
# Shared secret n8n sends in the X-Citadel-Secret header.
# Generate with: openssl rand -hex 32
CITADEL_SECRET=change-me

# Which host IP the orchestrator binds to.
# 127.0.0.1 = laptop only. Set to your Tailscale IP (tailscale ip -4)
# in Phase 0 step D so n8n on the VPS can reach it.
ORCH_BIND=127.0.0.1

# Max spec→code→review rounds before giving up and asking you.
PIPELINE_MAX_ROUNDS=3

# ── Models ───────────────────────────────────────────────────
# OmniRoute endpoint key: create it in the OmniRoute dashboard.
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://omniroute:20128/v1

# Combo / model names created in the OmniRoute dashboard.
MODEL_BRAIN=citadel-brain
MODEL_WORKER=citadel-worker
MODEL_CHEAP=citadel-cheap

# Private tier: talks to Ollama directly, never through OmniRoute.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
MODEL_PRIVATE=qwen2.5-coder:7b
MODEL_EMBED=nomic-embed-text

# ── OmniRoute container secrets ──────────────────────────────
# Check OmniRoute's own .env.example for the current list; these are
# the ones its Docker docs use. Generate each with openssl rand -hex 32.
OMNIROUTE_JWT_SECRET=change-me
OMNIROUTE_API_KEY_SECRET=change-me
OMNIROUTE_INITIAL_PASSWORD=change-me

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=citadel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=citadel
DATABASE_URL=postgresql://citadel:change-me@postgres:5432/citadel

REDIS_URL=redis://redis:6379/0

# ── Telegram (your single inbox) ─────────────────────────────
# Token from @BotFather. Chat ID: message your bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
