# Portfolio
{$DOMAIN} {
	root * /srv/site
	encode zstd gzip
	try_files {path} {path}/ /index.html
	file_server
}

# n8n
n8n.{$DOMAIN} {
	encode zstd gzip
	reverse_proxy n8n:5678
}

