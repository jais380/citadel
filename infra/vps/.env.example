# Citadel VPS settings. Copy to .env on the server. Never commit .env.

DOMAIN=yourdomain.com
ACME_EMAIL=you@example.com
TIMEZONE=Africa/Lagos

# openssl rand -hex 32 for each
N8N_DB_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me

# Your laptop's orchestrator over Tailscale (tailscale ip -4 on the laptop)
CITADEL_URL=http://100.x.y.z:8000
# Must match CITADEL_SECRET in the laptop's .env
CITADEL_SECRET=change-me
